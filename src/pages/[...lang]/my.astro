---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { langPaths, useTranslations, type Lang } from "@/i18n/ui";
import MyReservationsPage from "@/components/MyReservationsPage";

export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t("my.title")} noindex>
  <MyReservationsPage client:only="react" lang={lang} />
</BaseLayout>